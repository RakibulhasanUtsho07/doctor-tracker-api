NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker_dev
FRONTEND_ORIGINS=http://localhost:3000

# Required to enable first-admin signup in production; use a random 32+ byte one-time value.
# Leave blank for localhost development. Remove from production runtime after first-admin setup.
INITIAL_ADMIN_SETUP_TOKEN=

# One-time administrator creation only; remove these from runtime environments after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=
